---
import { NAV } from '../../site.config.mjs';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const isCurrent = (href) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="wordmark" href="/" aria-label="Rogan Recs home">
      <span class="wordmark__mark" aria-hidden="true">R</span>
      <span class="wordmark__text">Rogan <strong>Recs</strong></span>
    </a>

    <nav class="site-nav site-nav--desktop" aria-label="Primary">
      <ul>
        {NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <details class="mobile-menu">
      <summary>Menu</summary>
      <nav aria-label="Mobile primary">
        <ul>
          {NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>
