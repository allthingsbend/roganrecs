---
import { FOOTER_LINKS } from '../../site.config.mjs';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="shell">
    <div class="footer-cols">
      <div class="footer-intro">
        <a class="wordmark wordmark--footer" href="/" aria-label="Rogan Recs home">
          <span class="wordmark__mark" aria-hidden="true">R</span>
          <span class="wordmark__text">Rogan <strong>Recs</strong></span>
        </a>
        <p>
          A clear, independent guide to the supplements, gear, books and ideas discussed
          on the Joe Rogan Experience.
        </p>
        <p class="footer-kicker">Fan-curated. Source-led. No hype required.</p>
      </div>
      <div>
        <h2>Explore</h2>
        <ul>
          {FOOTER_LINKS.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </div>
      <div>
        <h2>Site</h2>
        <ul>
          <li><a href="/about">About</a></li>
          <li><a href="/contact">Contact</a></li>
          <li><a href="/rss.xml">RSS feed</a></li>
          <li><a href="/sitemap-html">Sitemap</a></li>
        </ul>
      </div>
    </div>
    <div class="legal">
      <p>
        Rogan Recs is an independent fan site and is not affiliated with Joe Rogan, the
        Joe Rogan Experience, Spotify or any brand mentioned. Content is informational,
        not medical advice. Some outbound links are affiliate links.
      </p>
      <p>&copy; {year} Rogan Recs.</p>
    </div>
  </div>
</footer>
