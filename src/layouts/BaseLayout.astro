---
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../../site.config.mjs';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  jsonLd?: Record<string, unknown>[];
}

const props = Astro.props;
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-PDGQNLLF');
    </script>
    <!-- End Google Tag Manager -->

    <Seo {...props} />
    <meta name="msvalidate.01" content="A4B8DEE0735FB7F98A41756F010DB78E" />

  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PDGQNLLF"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // Measure affiliate intent without delaying navigation. Works for the
      // new recommendation cards and existing Amazon links across old guides.
      document.addEventListener('click', function (event) {
        const link = event.target.closest('a');
        if (!link) return;
        const href = link.href || '';
        const isAmazon = /amazon\.|amzn\.to/i.test(href);
        const isMarkedAffiliate = link.hasAttribute('data-affiliate-link');
        if (!isAmazon && !isMarkedAffiliate) return;

        const card = link.closest('[data-product]');
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: 'affiliate_click',
          affiliate: isAmazon ? 'amazon' : 'other',
          product: link.dataset.product || card?.dataset.product || link.textContent.trim().slice(0, 100),
          cta: link.dataset.cta || link.textContent.trim().slice(0, 100),
          destination_url: href,
          page_path: window.location.pathname,
          link_position: card ? 'recommendation_card' : 'inline'
        });
      });
    </script>
  </body>
</html>
