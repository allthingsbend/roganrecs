---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import ContentCard from '../components/ContentCard.astro';
import { SITE, CATEGORIES } from '../../site.config.mjs';

interface Crumb { label: string; href?: string }
interface Heading { depth: number; slug: string; text: string }
interface RelatedItem {
  href: string;
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  category?: keyof typeof CATEGORIES;
}

interface Props {
  data: any;
  path: string;
  crumbs?: Crumb[];
  headings?: Heading[];
  related?: RelatedItem[];
  words?: number;
  isArticle?: boolean;
}

const {
  data,
  path,
  crumbs = [],
  headings = [],
  related = [],
  words = 0,
  isArticle = true,
} = Astro.props;

const published = data.pubDate ?? data.updated ?? undefined;
const modified = data.updated ?? data.pubDate ?? undefined;
const readMins = words ? Math.max(1, Math.round(words / 225)) : 0;

const fmt = (d) =>
  new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric' }).format(d);

const moneyGuidePicks = {
  '/supplements': {
    label: 'Quick shop',
    note: 'The highest-value places to start, not every bottle Rogan has ever mentioned.',
    links: [
      { name: 'Creatine monohydrate', href: 'https://www.amazon.com/s?k=creatine+monohydrate+powder&tag=rogan-recs-20' },
      { name: 'Alpha Brain', href: 'https://www.amazon.com/s?k=Onnit+Alpha+Brain&tag=rogan-recs-20' },
      { name: 'Macular Support', href: 'https://www.amazon.com/s?k=Pure+Encapsulations+Macular+Support&tag=rogan-recs-20' },
    ],
  },
  '/supplements/joe-rogan-creatine': {
    label: 'Quick shop',
    note: 'Plain creatine monohydrate is the simple pick. You do not need a fancy blend.',
    links: [
      { name: 'Creatine monohydrate', href: 'https://www.amazon.com/s?k=creatine+monohydrate+third+party+tested&tag=rogan-recs-20' },
      { name: 'Creatine gummies', href: 'https://www.amazon.com/s?k=creatine+gummies&tag=rogan-recs-20' },
    ],
  },
  '/supplements/neuro-gum-joe-rogan': {
    label: 'Quick shop',
    note: 'Neuro Gum is mainly caffeine plus L-theanine in a convenient format.',
    links: [
      { name: 'Neuro Gum', href: 'https://www.amazon.com/s?k=Neuro+Gum&tag=rogan-recs-20' },
      { name: 'Caffeine + L-theanine', href: 'https://www.amazon.com/s?k=caffeine+l-theanine&tag=rogan-recs-20' },
    ],
  },
  '/joe-rogan-sauna-guide': {
    label: 'Quick shop',
    note: 'Traditional sauna is the closest match to Rogan. Infrared is often easier for home use.',
    links: [
      { name: 'Traditional saunas', href: 'https://www.amazon.com/s?k=traditional+home+sauna&tag=rogan-recs-20' },
      { name: 'Infrared saunas', href: 'https://www.amazon.com/s?k=infrared+home+sauna&tag=rogan-recs-20' },
    ],
  },
  '/joe-rogan-cold-plunge-guide': {
    label: 'Quick shop',
    note: 'Compare a real tub setup first. Cheap portable tubs are a different experience but can be enough to start.',
    links: [
      { name: 'Cold plunge tubs', href: 'https://www.amazon.com/s?k=cold+plunge+tub&tag=rogan-recs-20' },
      { name: 'Portable ice baths', href: 'https://www.amazon.com/s?k=portable+ice+bath&tag=rogan-recs-20' },
    ],
  },
  '/podcast-guests/joe-rogan-podcast-equipment': {
    label: 'Quick shop',
    note: 'Start with the microphone. The rest of the studio can come later.',
    links: [
      { name: 'Shure SM7B', href: 'https://www.amazon.com/s?k=Shure+SM7B&tag=rogan-recs-20' },
      { name: 'Podcast headphones', href: 'https://www.amazon.com/s?k=professional+podcast+headphones&tag=rogan-recs-20' },
    ],
  },
  '/podcast-guests/joe-rogan-chair-jre-podcast': {
    label: 'Quick shop',
    note: 'The HAG Capisco is the classic JRE-associated saddle-style chair.',
    links: [
      { name: 'HAG Capisco', href: 'https://www.amazon.com/s?k=HAG+Capisco+8106&tag=rogan-recs-20' },
      { name: 'Saddle chair alternatives', href: 'https://www.amazon.com/s?k=ergonomic+saddle+chair&tag=rogan-recs-20' },
    ],
  },
  '/iron-neck-joe-rogan': {
    label: 'Quick shop',
    note: 'Iron Neck is the Rogan-associated option. Resistance-based neck trainers are the cheaper category.',
    links: [
      { name: 'Iron Neck options', href: 'https://www.amazon.com/s?k=Iron+Neck+trainer&tag=rogan-recs-20' },
      { name: 'Neck trainers', href: 'https://www.amazon.com/s?k=neck+training+harness&tag=rogan-recs-20' },
    ],
  },
  '/joe-rogan-books': {
    label: 'Quick shop',
    note: 'Browse the books first, then use the guide to see why each one came up.',
    links: [
      { name: 'Rogan book picks', href: 'https://www.amazon.com/s?k=Joe+Rogan+recommended+books&tag=rogan-recs-20' },
    ],
  },
  '/joe-rogan-coffee': {
    label: 'Quick shop',
    note: 'Coffee is one of the simpler categories. Buy for roast, freshness and taste, not podcast mythology.',
    links: [
      { name: 'Black Rifle Coffee', href: 'https://www.amazon.com/s?k=Black+Rifle+Coffee&tag=rogan-recs-20' },
      { name: 'Organic whole bean coffee', href: 'https://www.amazon.com/s?k=organic+whole+bean+coffee&tag=rogan-recs-20' },
    ],
  },
};

const quickShop = moneyGuidePicks[path];

const jsonLd = [];

if (crumbs.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.label,
      ...(c.href ? { item: `${SITE.url}${c.href === '/' ? '' : c.href}` } : {}),
    })),
  });
}

if (isArticle) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: data.h1 ?? data.title,
    description: data.description,
    mainEntityOfPage: { '@type': 'WebPage', '@id': `${SITE.url}${path}` },
    author: { '@type': 'Organization', name: data.author ?? SITE.name, url: SITE.url },
    publisher: {
      '@type': 'Organization',
      name: SITE.name,
      logo: { '@type': 'ImageObject', url: new URL('/images/logo.png', SITE.url).href },
    },
    ...(published ? { datePublished: new Date(published).toISOString() } : {}),
    ...(modified ? { dateModified: new Date(modified).toISOString() } : {}),
    ...(data.image ? { image: new URL(data.image, SITE.url).href } : {}),
  });
}

if (data.faq?.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: data.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}

const categoryLabel = CATEGORIES[data.category] ?? 'Rogan Recs';
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3).slice(0, 12);
const featuredSelector = data.image?.replace(/["\\]/g, '\\$&');
---
<BaseLayout
  title={data.title}
  description={data.description}
  path={path}
  noindex={data.noindex}
  image={data.image}
  imageAlt={data.imageAlt}
  type={isArticle ? 'article' : 'website'}
  publishedTime={published ? new Date(published) : undefined}
  modifiedTime={modified ? new Date(modified) : undefined}
  jsonLd={jsonLd}
>
  <section class="article-hero">
    <div class="shell">
      {crumbs.length > 1 && <Breadcrumbs items={crumbs} />}
      <div class:list={['article-hero__grid', { 'article-hero__grid--text': !data.image }]}>
        <div class="article-hero__copy">
          <p class="eyebrow">{categoryLabel}</p>
          <h1>{data.h1 ?? data.title}</h1>
          <p class="article-hero__lede">{data.description}</p>
          <div class="spec-strip">
            {modified && <span>Updated {fmt(new Date(modified))}</span>}
            {readMins > 0 && <span>{readMins} min read</span>}
            <span>Independent guide</span>
          </div>

          {quickShop && (
            <div class="hero-shop" aria-label="Quick shopping links">
              <div class="hero-shop__head">
                <strong>{quickShop.label}</strong>
                <span>{quickShop.note}</span>
              </div>
              <p class="hero-shop__disclosure">Affiliate links. As an Amazon Associate I earn from qualifying purchases.</p>
              <div class="hero-shop__links">
                {quickShop.links.map((item) => (
                  <a
                    href={item.href}
                    target="_blank"
                    rel="sponsored nofollow noopener"
                    data-affiliate-link
                    data-product={item.name}
                    data-cta="hero quick shop"
                  >
                    {item.name} <span aria-hidden="true">→</span>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
        {data.image && (
          <figure class="article-hero__media">
            <img
              src={data.image}
              alt={data.imageAlt ?? `${data.h1 ?? data.title} guide`}
              width="900"
              height="600"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </figure>
        )}
      </div>
    </div>
  </section>

  <div class="guide-standard" aria-label="Rogan Recs editorial standards">
    <div class="shell guide-standard__inner">
      <div class="guide-standard__intro">
        <span class="guide-standard__mark">RR</span>
        <div>
          <strong>Built to answer the actual question</strong>
          <span>Not a 3,000-word detour before the useful part.</span>
        </div>
      </div>
      <ul>
        <li><span>01</span> Public sources checked</li>
        <li><span>02</span> Marketing claims separated</li>
        <li><span>03</span> Buying advice included</li>
      </ul>
    </div>
  </div>

  <div class="shell article-shell">
    <article class="article">
      {!quickShop && <AffiliateDisclosure />}

      {tocHeadings.length >= 2 && (
        <details class="mobile-toc">
          <summary>On this page</summary>
          <ol>
            {tocHeadings.map((heading) => (
              <li class:list={{ 'toc-subitem': heading.depth === 3 }}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </details>
      )}

      <div class="article-content">
        <slot />
      </div>

      {data.faq && data.faq.length > 0 && (
        <section class="faq-section" aria-labelledby="faq-heading">
          <p class="eyebrow">Quick answers</p>
          <h2 id="faq-heading">Common questions</h2>
          <div class="faq-list">
            {data.faq.map((f, index) => (
              <details class="faq-item" open={index === 0}>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      )}
    </article>

    {tocHeadings.length >= 2 && (
      <aside class="article-sidebar" aria-label="On this page">
        <div class="article-sidebar__inner">
          <p>On this page</p>
          <ol>
            {tocHeadings.map((heading) => (
              <li class:list={{ 'toc-subitem': heading.depth === 3 }}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
          <div class="article-sidebar__note">
            <strong>No hype rule</strong>
            <span>If a claim is weak, sponsored or outdated, the guide should say so.</span>
          </div>
        </div>
      </aside>
    )}
  </div>

  {related.length > 0 && (
    <section class="related-section">
      <div class="shell">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Keep exploring</p>
            <h2>Go down another rabbit hole</h2>
          </div>
          <a href="/blog">View all articles <span aria-hidden="true">→</span></a>
        </div>
        <ul class="card-grid">
          {related.map((item) => <ContentCard {...item} />)}
        </ul>
      </div>
    </section>
  )}

  {data.image && (
    <style
      is:inline
      set:html={`.article-content p:has(> img[src="${featuredSelector}"]:only-child) { display: none; }`}
    ></style>
  )}

  <style is:global>
    .hero-shop {
      max-width: 660px;
      margin-top: 1.35rem;
      border: 1px solid rgba(255,255,255,.17);
      border-radius: 1rem;
      padding: .95rem;
      background: rgba(255,255,255,.07);
      backdrop-filter: blur(10px);
      font-family: var(--font-ui);
    }
    .hero-shop__head {
      display: grid;
      gap: .2rem;
    }
    .hero-shop__head strong {
      color: #fff;
      font: 800 .78rem/1 var(--font-ui);
      letter-spacing: .08em;
      text-transform: uppercase;
    }
    .hero-shop__head span {
      color: #bdb8ae;
      font-size: .78rem;
      line-height: 1.4;
    }
    .hero-shop__disclosure {
      margin: .55rem 0 .65rem;
      color: #918c83;
      font: 500 .67rem/1.35 var(--font-ui);
    }
    .hero-shop__links {
      display: flex;
      flex-wrap: wrap;
      gap: .55rem;
    }
    .hero-shop__links a {
      min-height: 42px;
      display: inline-flex;
      align-items: center;
      justify-content: space-between;
      gap: .65rem;
      border-radius: 999px;
      padding: .68rem .9rem;
      background: #fff;
      color: var(--ink);
      font: 800 .77rem/1 var(--font-ui);
      text-decoration: none;
      box-shadow: 0 8px 20px rgba(0,0,0,.12);
    }
    .hero-shop__links a:hover {
      background: var(--gold);
      color: var(--ink);
    }
    .hero-shop__links a span {
      color: var(--accent-dark);
    }
    .guide-standard {
      border-bottom: 1px solid var(--line);
      background: #fff;
      font-family: var(--font-ui);
    }
    .guide-standard__inner {
      min-height: 86px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
    }
    .guide-standard__intro {
      display: flex;
      align-items: center;
      gap: .9rem;
      min-width: 0;
    }
    .guide-standard__mark {
      width: 2.35rem;
      height: 2.35rem;
      flex: 0 0 auto;
      display: grid;
      place-items: center;
      border-radius: 50%;
      background: var(--ink);
      color: var(--gold);
      font: 800 .7rem/1 var(--font-display);
      letter-spacing: -.02em;
    }
    .guide-standard__intro div {
      display: grid;
      gap: .1rem;
    }
    .guide-standard__intro strong {
      color: var(--ink);
      font-size: .82rem;
      line-height: 1.25;
    }
    .guide-standard__intro div > span {
      color: var(--muted);
      font-size: .72rem;
      line-height: 1.35;
    }
    .guide-standard ul {
      display: flex;
      gap: 1.35rem;
      list-style: none;
      margin: 0;
      padding: 0;
      color: var(--muted);
      font-size: .72rem;
      font-weight: 650;
    }
    .guide-standard li {
      display: flex;
      align-items: center;
      gap: .45rem;
      white-space: nowrap;
    }
    .guide-standard li span {
      color: var(--accent-dark);
      font: 800 .62rem/1 var(--font-display);
    }
    .article-content > blockquote:first-of-type {
      position: relative;
      margin: 1.2rem 0 2.4rem;
      border: 0;
      border-radius: 1rem;
      padding: 1.25rem 1.4rem 1.25rem 1.55rem;
      background: #fff;
      box-shadow: 0 12px 35px rgba(31,28,23,.09);
      color: var(--ink);
      font-family: var(--font-ui);
      font-size: 1rem;
      font-style: normal;
      line-height: 1.55;
    }
    .article-content > blockquote:first-of-type::before {
      content: 'THE SHORT VERSION';
      display: block;
      margin-bottom: .55rem;
      color: var(--accent-dark);
      font: 800 .65rem/1 var(--font-ui);
      letter-spacing: .12em;
    }
    .article-content > blockquote:first-of-type::after {
      content: '';
      position: absolute;
      inset: .75rem auto .75rem 0;
      width: 4px;
      border-radius: 99px;
      background: var(--accent);
    }
    .article-content h2 {
      position: relative;
      padding-top: .8rem;
    }
    .article-content h2::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 2.4rem;
      height: 3px;
      border-radius: 99px;
      background: var(--accent);
    }
    .article-content table {
      box-shadow: 0 10px 30px rgba(31,28,23,.055);
    }
    .article-content tbody tr:nth-child(even) td {
      background: #faf8f3;
    }
    .article-content strong {
      color: #11110f;
    }
    .article-content a:not(.button):not(.rec__cta) {
      font-weight: 600;
      text-decoration-color: rgba(201,70,24,.35);
      text-decoration-thickness: 2px;
    }
    .article-content a:not(.button):not(.rec__cta):hover {
      text-decoration-color: var(--accent-dark);
    }

    .article-content p > a[href*="amazon.com"]:only-child,
    .article-content p > a[href*="amzn.to"]:only-child,
    .article-content p > a[href*="amazon.co.uk"]:only-child,
    .article-content p > a[href*="amazon.ca"]:only-child {
      display: inline-flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      min-height: 50px;
      margin: .25rem 0 .6rem;
      border: 1px solid #1d1b17;
      border-radius: .8rem;
      padding: .78rem 1rem;
      background: #1d1b17;
      color: #fff;
      font-family: var(--font-ui);
      font-size: .88rem;
      font-weight: 800;
      line-height: 1.2;
      text-decoration: none;
      box-shadow: 0 7px 20px rgba(31,28,23,.12);
      transition: transform .15s ease, box-shadow .15s ease, background .15s ease;
    }
    .article-content p > a[href*="amazon.com"]:only-child::after,
    .article-content p > a[href*="amzn.to"]:only-child::after,
    .article-content p > a[href*="amazon.co.uk"]:only-child::after,
    .article-content p > a[href*="amazon.ca"]:only-child::after {
      content: 'Amazon ↗';
      flex: 0 0 auto;
      border-radius: 999px;
      padding: .34rem .55rem;
      background: var(--gold);
      color: #1d1b17;
      font-size: .66rem;
      font-weight: 850;
      letter-spacing: .02em;
    }
    .article-content p > a[href*="amazon.com"]:only-child:hover,
    .article-content p > a[href*="amzn.to"]:only-child:hover,
    .article-content p > a[href*="amazon.co.uk"]:only-child:hover,
    .article-content p > a[href*="amazon.ca"]:only-child:hover {
      transform: translateY(-1px);
      background: #29261f;
      box-shadow: 0 10px 26px rgba(31,28,23,.16);
      text-decoration: none;
    }
    .article-content p > a[href*="amazon.com"]:only-child:focus-visible,
    .article-content p > a[href*="amzn.to"]:only-child:focus-visible,
    .article-content p > a[href*="amazon.co.uk"]:only-child:focus-visible,
    .article-content p > a[href*="amazon.ca"]:only-child:focus-visible {
      outline: 3px solid var(--gold);
      outline-offset: 3px;
    }

    .article-content table a[href*="amazon.com"],
    .article-content table a[href*="amzn.to"],
    .article-content table a[href*="amazon.co.uk"],
    .article-content table a[href*="amazon.ca"] {
      display: inline-flex;
      align-items: center;
      min-height: 38px;
      border: 1px solid var(--line);
      border-radius: .65rem;
      padding: .48rem .68rem;
      background: #fff;
      color: var(--ink);
      font-family: var(--font-ui);
      font-size: .76rem;
      font-weight: 800;
      line-height: 1.15;
      text-decoration: none;
      white-space: normal;
    }
    .article-content table a[href*="amazon.com"]::after,
    .article-content table a[href*="amzn.to"]::after,
    .article-content table a[href*="amazon.co.uk"]::after,
    .article-content table a[href*="amazon.ca"]::after {
      content: ' ↗';
      margin-left: .2rem;
      color: var(--accent-dark);
    }
    .article-content table a[href*="amazon.com"]:hover,
    .article-content table a[href*="amzn.to"]:hover,
    .article-content table a[href*="amazon.co.uk"]:hover,
    .article-content table a[href*="amazon.ca"]:hover {
      border-color: var(--accent-dark);
      text-decoration: none;
    }

    .article-sidebar__inner {
      border-left: 0;
      border-radius: .9rem;
      padding: 1.15rem;
      background: rgba(255,255,255,.6);
      box-shadow: inset 0 0 0 1px var(--line);
    }
    .article-sidebar__note {
      display: grid;
      gap: .3rem;
      margin-top: 1.15rem;
      border-top: 1px solid var(--line);
      padding-top: 1rem;
      color: var(--muted);
      font-family: var(--font-ui);
    }
    .article-sidebar__note strong {
      color: var(--ink);
      font-size: .7rem;
      letter-spacing: .07em;
      text-transform: uppercase;
    }
    .article-sidebar__note span {
      font-size: .72rem;
      line-height: 1.45;
    }
    .faq-section {
      border: 1px solid var(--line);
      border-radius: 1.15rem;
      padding: 1.6rem 1.6rem .5rem;
      background: #fff;
      box-shadow: 0 12px 35px rgba(31,28,23,.055);
    }
    .faq-list { border-top: 0; }
    .faq-item:last-child { border-bottom: 0; }
    @media (max-width: 980px) {
      .guide-standard__inner { align-items: flex-start; flex-direction: column; gap: 1rem; padding-block: 1rem; }
      .guide-standard ul { width: 100%; flex-wrap: wrap; gap: .6rem 1.2rem; }
    }
    @media (max-width: 640px) {
      .hero-shop { margin-top: 1.1rem; }
      .hero-shop__links { display: grid; grid-template-columns: 1fr; }
      .hero-shop__links a { width: 100%; }
      .guide-standard__intro div > span { display: none; }
      .guide-standard ul { display: grid; grid-template-columns: 1fr; gap: .45rem; }
      .article-content > blockquote:first-of-type { padding: 1.1rem 1.15rem 1.1rem 1.3rem; }
      .faq-section { margin-inline: -.2rem; padding: 1.2rem 1rem .3rem; }
      .article-content p > a[href*="amazon.com"]:only-child,
