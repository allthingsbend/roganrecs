---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import ContentCard from '../components/ContentCard.astro';
import { resolveTitle } from '../lib/seo.mjs';
import { TOP_PICKS } from '../data/picks.mjs';

const home = await getEntry('pages', 'home');
const { Content } = await render(home);

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate))
  .slice(0, 6);

const guides = (await getCollection('pages'))
  .filter((p) => !p.data.hidden && p.id !== 'home' && !p.id.includes('/'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);

const dateFmt = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});

const fallbackImages = {
  supplements: '/images/blog-methylated-vitamins/vitamins-on-counter.png',
  gear: '/images/blog-joe-rogan-kettlebells/kettlebells.png',
  wellness: '/images/joe-rogan-sauna-guide/sauna-kettlebell.png',
  outdoors: '/images/blog-joe-rogan-elk/elk-in-oregon-rogan.jpg',
  comedy: '/images/blog-comedy-mothership/comedy-mothershp.jpg',
  podcast: '/images/podcast-guests/podcast-microphone.png',
  food: '/images/joe-rogan-coffee/coffee-weights.png',
  site: undefined,
};
---
<BaseLayout
  title={resolveTitle(home.data.title, home.data.updated)}
  description={home.data.description}
  path="/"
  image={home.data.image}
  type="website"
>
  <section class="home-hero">
    <div class="shell home-hero__grid">
      <div class="home-hero__copy">
        <p class="eyebrow">The independent JRE field guide</p>
        <h1>{home.data.h1}</h1>
        <p>{home.data.description}</p>
        <div class="button-row">
          <a class="button button--accent" href="/joe-rogan-products">Browse what Rogan uses</a>
          <a class="button button--ghost" href="/supplements">Explore the supplement stack</a>
        </div>
        <ul class="trust-list" aria-label="How Rogan Recs works">
          <li>Public episodes & interviews</li>
          <li>Evidence noted plainly</li>
          <li>Independent fan site</li>
        </ul>
      </div>

      <div class="hero-collage" aria-label="Featured Rogan Recs guides">
        <a class="hero-collage__main" href="/joe-rogan-products">
          <img
            src="/images/joe-rogan-sauna-guide/joe-rogan-sauna-guide.png"
            alt="Home sauna representing Joe Rogan products and gear"
            width="900"
            height="600"
            loading="eager"
            fetchpriority="high"
          />
          <span><small>Start here</small> What Joe Rogan uses</span>
        </a>
        <a href="/supplements">
          <img
            src="/images/blog-methylated-vitamins/vitamins-on-counter.png"
            alt="Supplements arranged on a counter"
            width="450"
            height="300"
            loading="eager"
          />
          <span>Supplement stack</span>
        </a>
        <a href="/podcast-guests/joe-rogan-podcast-equipment">
          <img
            src="/images/podcast-guests/podcast-microphone.png"
            alt="Podcast microphone"
            width="450"
            height="300"
            loading="eager"
          />
          <span>Podcast gear</span>
        </a>
      </div>
    </div>
  </section>

  <section class="topic-rail" aria-label="Browse by topic">
    <div class="shell">
      <span>Browse:</span>
      <a href="/joe-rogan-products">All products</a>
      <a href="/supplements">Supplements</a>
      <a href="/joe-rogan-sauna-guide">Sauna</a>
      <a href="/joe-rogan-cold-plunge-guide">Cold plunge</a>
      <a href="/joe-rogan-books">Books</a>
      <a href="/joe-rogan-coffee">Coffee</a>
      <a href="/podcast-guests/joe-rogan-podcast-equipment">Podcast gear</a>
      <a href="/gifts-for-joe-rogan-fans">Gift guide</a>
    </div>
  </section>

  <section class="picks" aria-labelledby="picks-title">
    <div class="shell">
      <div class="picks__head">
        <div>
          <p class="eyebrow">The short list</p>
          <h2 id="picks-title">Six things with a real Rogan connection</h2>
        </div>
        <p>Not his whole cabinet. These are the picks where the link to Rogan is documented and the product holds up on its own. Each one has a full guide if you want the receipts.</p>
      </div>
      <ol class="picks__grid">
        {TOP_PICKS.map((p, i) => (
          <li class="pick" data-product={p.name}>
            <div class="pick__top">
              <span class="pick__num">{String(i + 1).padStart(2, '0')}</span>
              <span class="pick__kind">{p.kind}</span>
            </div>
            <h3 class="pick__name">{p.name}</h3>
            <p class="pick__link"><span aria-hidden="true">✓</span> {p.connection}</p>
            <p class="pick__take">{p.take}</p>
            <div class="pick__actions">
              <a class="pick__buy" href={p.href} target="_blank" rel="sponsored nofollow noopener" data-affiliate-link data-product={p.name} data-cta="home short list">Check price on Amazon</a>
              <a class="pick__guide" href={p.guide}>Why it made the list</a>
            </div>
          </li>
        ))}
      </ol>
      <p class="picks__note">Affiliate links. As an Amazon Associate, Rogan Recs earns from qualifying purchases. It never decides what makes the list. <a href="/joe-rogan-products">See every product we track →</a></p>
    </div>
  </section>

  <div class="shell home-disclosure">
    <AffiliateDisclosure />
  </div>

  <div class="shell home-sections">
    <section class="section" id="guides">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Start here</p>
          <h2>Essential guides</h2>
        </div>
        <a href="/joe-rogan-products">Search all products <span aria-hidden="true">→</span></a>
      </div>
      <ul class="card-grid">
        {guides.map((g) => (
          <ContentCard
            href={`/${g.id}`}
            title={g.data.h1 ?? g.data.title}
            description={g.data.description}
            image={g.data.image ?? fallbackImages[g.data.category]}
            imageAlt={g.data.imageAlt}
            category={g.data.category}
          />
        ))}
      </ul>
    </section>

    <section class="section section--tinted">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Go deeper</p>
          <h2>Recent deep dives</h2>
        </div>
        <a href="/blog">Visit the blog <span aria-hidden="true">→</span></a>
      </div>
      <ul class="card-grid">
        {posts.map((p) => (
          <ContentCard
            href={`/blog/${p.id}`}
            title={p.data.h1 ?? p.data.title}
            description={p.data.description}
            image={p.data.image ?? fallbackImages[p.data.category]}
            imageAlt={p.data.imageAlt}
            category={p.data.category}
            meta={dateFmt.format(new Date(p.data.pubDate))}
          />
        ))}
      </ul>
    </section>
  </div>

  <section class="home-explainer">
    <div class="shell home-explainer__grid">
      <div class="home-explainer__intro">
        <p class="eyebrow">A useful index, not a hype machine</p>
        <h2>What was discussed, what it does and whether it makes sense.</h2>
        <p>
          The JRE covers a lot of ground. Rogan Recs turns those long conversations into
          practical, readable guides with uncertainty and safety caveats left intact.
        </p>
      </div>
      <div class="article home-explainer__content">
        <Content />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .picks{padding-block:clamp(2.75rem,6vw,4.5rem);background:var(--paper);border-bottom:1px solid var(--line)}
  .picks__head{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(1.5rem,5vw,4rem);align-items:end;margin-bottom:1.8rem}
  .picks__head h2{margin:0;font-size:var(--step-3);line-height:1.06;letter-spacing:-.035em}
  .picks__head>p{margin:0;color:var(--muted);font-family:var(--font-ui);font-size:.95rem;line-height:1.6}
  .picks__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;list-style:none;margin:0;padding:0}
  .pick{display:flex;flex-direction:column;min-width:0;border:1px solid var(--line);border-radius:var(--radius);padding:1.2rem 1.2rem 1.1rem;background:var(--surface);font-family:var(--font-ui);transition:border-color 180ms ease,box-shadow 180ms ease}
  .pick:hover{border-color:#c9c0b3;box-shadow:var(--shadow)}
  .pick__top{display:flex;align-items:center;justify-content:space-between;gap:.75rem}
  .pick__num{color:var(--accent);font:700 1.05rem/1 var(--font-display)}
  .pick__kind{color:var(--muted);font:700 .64rem/1 var(--font-ui);letter-spacing:.1em;text-transform:uppercase}
  .pick__name{margin:.7rem 0 .55rem;font-size:1.3rem;line-height:1.12;letter-spacing:-.02em}
  .pick__link{align-self:flex-start;margin:0 0 .75rem;border-radius:99px;padding:.35rem .6rem;background:#f5efe2;color:var(--ink-3);font-size:.74rem;font-weight:700;line-height:1.3}
  .pick__link span{color:var(--sage,#4f7a5a)}
  .pick__take{margin:0 0 1rem;color:var(--ink-3);font-size:.88rem;line-height:1.55}
  .pick__actions{display:grid;gap:.5rem;margin-top:auto}
  .pick__buy{display:flex;align-items:center;justify-content:center;min-height:44px;border-radius:.7rem;background:var(--ink);color:#fff;font-weight:700;font-size:.8rem;text-decoration:none}
  .pick__buy:hover{background:var(--accent-dark);color:#fff}
  .pick__guide{color:var(--ink);font-size:.78rem;font-weight:700;text-align:center;text-decoration:none}
  .pick__guide:hover{color:var(--accent-dark)}
  .picks__note{margin:1.2rem 0 0;color:var(--muted);font-family:var(--font-ui);font-size:.74rem;line-height:1.5}
  .picks__note a{font-weight:700}
  @media(max-width:900px){.picks__head{grid-template-columns:1fr}.picks__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:600px){.picks__grid{grid-template-columns:1fr}.pick__actions{grid-template-columns:1fr}}
</style>
